)
config.baremetal_start = "@CMAKE_BINARY_DIR@/runtime/bare-metal/@TARGET_FAMILY@/start.S"

lit_config.load_config(config, "@CMAKE_CURRENT_SOURCE_DIR@/lit.cfg.py")
