mainmenu "RISC Build Configuration"

menu "Generated directories"

config RISC_BUILD_DIR
  string "Top-level generated build directory"
  default "build"
  help
    Root build directory for generated RTL, generated headers, generated runtime,
    generated configuration files, and other top-level generated artifacts.

config GEN_DIR
  string "Generated RTL directory"
  default "build"
  help
    Directory containing generated RTL such as top.sv.

config GENERATED_INCLUDE_DIR
  string "Generated C/C++ include directory"
  default "build/include"
  help
    Directory containing generated C/C++ headers.

config SYNTH_DIR
  string "Synthesis output directory"
  default "synth"

config SIM_BUILD_DIR
  string "Simulator CMake build directory"
  default "build/sim"

config RUNTIME_ROOT
  string "Generated runtime root"
  default "build/runtime"
  help
    Runtime root generated by Scala. The final runtime directory is:
    RUNTIME_ROOT/RUNTIME_PROFILE/TARGET_FAMILY.

endmenu

menu "CMake"

choice CMAKE_GENERATOR
  prompt "CMake generator"
  default CMAKE_GENERATOR_NINJA

config CMAKE_GENERATOR_NINJA
  bool "Ninja"

config CMAKE_GENERATOR_MAKE
  bool "Unix Makefiles"

endchoice

config BUILD_TYPE
  string "CMake build type"
  default "Release"
  help
    Common values: Debug, Release, RelWithDebInfo, MinSizeRel.

config USE_CCACHE
  bool "Use ccache"
  default y

endmenu

menu "Simulator"

config ENABLE_SIM
  bool "Enable simulator"
  default y

config ENABLE_DBG
  bool "Enable debugger"
  default y

config ENABLE_DIFF
  bool "Enable difftest"
  default y

config ENABLE_TESTING
  bool "Enable tests"
  default y

config ENABLE_TRACE
  bool "Enable waveform tracing"
  default y

config ENABLE_COVERAGE
  bool "Enable coverage"
  default y

config NUM_THREADS
  int "Verilator simulation threads"
  range 1 1024
  default 1

config NUM_TRACE_THREADS
  int "Verilator trace threads"
  range 1 1024
  default 2

endmenu

menu "Generated runtime"

config RUNTIME_PROFILE
  string "Runtime profile"
  default "bare-metal"

config LINKER_SCRIPT_NAME
  string "Generated linker script filename"
  default "linker.ld"

config STARTUP_SOURCE_NAME
  string "Generated startup source filename"
  default "start.S"

endmenu

menu "Benchmarks"

config ENABLE_COREMARK
  bool "Enable CoreMark"
  default n

config COREMARK_ENABLE_DEBUG
  bool "Enable CoreMark debug"
  default n
  depends on ENABLE_COREMARK

config COREMARK_TOTAL_DATA_SIZE
  string "CoreMark total data size"
  default "2000"
  depends on ENABLE_COREMARK

config COREMARK_ITERATIONS
  string "CoreMark iterations"
  default "1"
  depends on ENABLE_COREMARK

config COREMARK_EXECS
  string "CoreMark execs"
  default "7"
  depends on ENABLE_COREMARK

endmenu

menu "STA"

choice STA_TOOL
  prompt "Default STA tool"
  default STA_TOOL_YOSYS

config STA_TOOL_YOSYS
  bool "Yosys"

config STA_TOOL_VIVADO
  bool "Vivado"

endchoice

endmenu
